# 测试环境（敏感值通过 GitHub Secrets / 服务器环境变量注入，此处为默认值）
DATABASE_URL="postgresql://postgres:staging_password@db:5432/docker_demo?schema=public"
PORT=3001
FILE_BASE_URL=https://stage-docker-demo.ankkaya.top
JWT_SECRET=staging-jwt-secret-change-in-secrets
JWT_REFRESH_SECRET=staging-refresh-secret-change-in-secrets
JWT_REFRESH_EXPIRES_IN=30d
NODE_ENV=staging
ENABLE_SWAGGER=true
CORS_ORIGINS=https://stage-docker-demo.ankkaya.top

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=docker-demo

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_IN_SECRETS
