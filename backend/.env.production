# 正式环境（⚠️ 敏感值必须通过 GitHub Secrets / 服务器环境变量覆盖，切勿直接填写真实密钥）
DATABASE_URL="postgresql://postgres:CHANGE_ME@db:5432/docker_demo?schema=public"
PORT=3001
FILE_BASE_URL=https://your-production-domain.com
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_SECRETS
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_SECRETS
JWT_REFRESH_EXPIRES_IN=30d
NODE_ENV=production
ENABLE_SWAGGER=false
CORS_ORIGINS=https://admin.your-production-domain.com,https://m.your-production-domain.com

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=docker-demo

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME
