generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 用户模型
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String?   @unique
  password  String
  name      String?
  wechatOpenId String? @unique
  wechatUnionId String? @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 软删除标记

  // 用户与角色多对多关系
  roles     Role[]    @relation("UserRoles")
  // 关联客户档案（一个用户对应一个客户）
  customer  Customer?
  // 关联购物车
  carts     Cart[]
  reviews   Review[]

  @@index([deletedAt])
}

// 角色模型
model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // 软删除标记

  // 角色与用户多对多关系
  users       User[]    @relation("UserRoles")
  // 角色与菜单多对多关系
  menus       Menu[]    @relation("RoleMenus")

  @@index([deletedAt])
}

// 菜单模型（树形结构）
model Menu {
  id          Int       @id @default(autoincrement())
  name        String
  path        String?
  icon        String?
  component   String?
  redirect    String?
  parentId    Int?
  order       Int       @default(0)
  hidden      Boolean   @default(false)
  alwaysShow  Boolean   @default(false)
  type        String    @default("menu") // menu, button, iframe
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // 软删除标记

  // 自关联 - 父级菜单
  parent      Menu?     @relation("MenuChildren", fields: [parentId], references: [id])
  children    Menu[]    @relation("MenuChildren")

  // 角色与菜单多对多关系
  roles       Role[]    @relation("RoleMenus")

  @@index([deletedAt])
}

// ==================== 打印管理模块 ====================

// 打印模板
model PrintTemplate {
  id          Int       @id @default(autoincrement())
  name        String    // 模板名称
  bizType     String    // 业务类型：ORDER(销售订单)/SHIPMENT(发货单)/PURCHASE(采购单)/PRODUCT_LABEL(商品标签)
  paperWidth  Float     @default(50)   // 纸张宽度(mm)，最大50
  paperHeight Float     @default(50)   // 纸张高度(mm)，最大300
  content     Json?     // 模板内容（JSON）
  description String?
  sort        Int       @default(0)
  isEnabled   Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  configs     PrinterConfig[]

  @@index([deletedAt])
}

// 打印机
model Printer {
  id        Int       @id @default(autoincrement())
  name      String    // 打印机名称
  device    String    @unique // 打印机终端（设备标识）
  remark    String?   // 备注
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  configs PrinterConfig[]

  @@index([deletedAt])
}

// 打印配置（模板 + 打印机 + 参数）
model PrinterConfig {
  id            Int       @id @default(autoincrement())
  name          String    // 配置名称
  templateId    Int?      // 模板ID
  template      PrintTemplate? @relation(fields: [templateId], references: [id])
  printerId     Int?      // 打印机ID
  printer       Printer?  @relation(fields: [printerId], references: [id])
  copies        Int       @default(1) // 打印份数
  orientation   Int       @default(0) // 打印方向 0/90/180/270
  gapType       Int       @default(255) // 纸张间隙类型
  paperType     String    @default("LABEL") // 纸张类型: CONTINUOUS(连续纸)/LABEL(标签纸)/MARK(黑标纸)/PERFORATED(穿孔纸)
  printSpeed    Int       @default(255) // 打印速度
  printDarkness Int       @default(255) // 打印浓度/深度
  printMode     String    @default("PRINT") // 打印模式: PRINT/PREV_BASE64/TRANS_BASE64/PRINT_DATA
  isDefault     Boolean   @default(false) // 是否默认配置
  isEnabled     Boolean   @default(true) // 是否启用
  remark        String?   // 备注
  deletedAt     DateTime? // 软删除标记
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deletedAt])
  @@index([templateId])
  @@index([printerId])
}

// ==================== 基础数据模块 ====================

// 计量单位
model Unit {
  id        Int       @id @default(autoincrement())
  name      String    @unique // 单位名称：个、箱、kg
  code      String    @unique // 单位编码
  sort      Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 软删除标记

  @@index([deletedAt])
}

// 商品分类（树形结构）
model Category {
  id        Int        @id @default(autoincrement())
  name      String     // 分类名称
  code      String     @unique // 分类编码
  subtitle  String?    // 子标题
  remark    String?    // 备注
  parentId  Int?       // 父级ID
  level     Int        @default(1) // 层级
  sort      Int        @default(0)
  icon      String?    // 图标
  image     String?    // 分类图片
  isEnabled Boolean    @default(true)
  deletedAt DateTime?  // 软删除标记
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([deletedAt])
}

// 品牌
model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique // 品牌名称
  logo        String?   // 品牌logo
  description String?   // 品牌描述
  sort        Int       @default(0)
  isEnabled   Boolean   @default(true)
  deletedAt   DateTime? // 软删除标记
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

// 商城轮播图
model Banner {
  id          Int       @id @default(autoincrement())
  title       String    // 轮播图标题
  tag         String?   // 轮播图标签
  subtitle    String?   // 轮播图子标题
  image       String    // 图片地址或对象键
  jumpEnabled Boolean   @default(false) // 是否启用跳转
  jumpPath    String?   // 跳转路径
  sort        Int       @default(0)
  remark      String?   // 备注
  isEnabled   Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@index([isEnabled, sort])
}

// 仓库
model Warehouse {
  id          Int               @id @default(autoincrement())
  name        String            // 仓库名称
  code        String            @unique // 仓库编码
  address     String?           // 地址
  contact     String?           // 联系人
  phone       String?           // 联系电话
  isDefault   Boolean           @default(false) // 是否默认仓库
  isEnabled   Boolean           @default(true)
  deletedAt   DateTime?         // 软删除标记
  inventories Inventory[]
  receipts    PurchaseReceipt[]
  returns     PurchaseReturn[] // 采购退货单
  shipments   Shipment[]       // 发货单
  saleReturns SaleReturn[]     // 销售退货单
  transfersFrom Transfer[]     @relation("TransferFrom") // 调拨出库
  transfersTo   Transfer[]     @relation("TransferTo")   // 调拨入库
  adjustments   Adjustment[]   // 库存调整单
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([deletedAt])
}

// 供应商
model Supplier {
  id          Int       @id @default(autoincrement())
  name        String    // 供应商名称
  code        String    @unique // 供应商编码
  contact     String?   // 联系人
  phone       String?   // 联系电话
  email       String?   // 邮箱
  address     String?   // 地址
  bankName    String?   // 开户行
  bankAccount String?   // 银行账号
  taxNo       String?   // 税号
  creditLimit Decimal?  @db.Decimal(12, 2) // 信用额度
  period      Int       @default(30) // 账期(天)
  isEnabled   Boolean   @default(true)
  remark      String?   // 备注
  deletedAt   DateTime? // 软删除标记
  purchases   Purchase[] // 采购订单
  returns     PurchaseReturn[] // 采购退货单
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

// 客户类型枚举
enum CustomerType {
  INDIVIDUAL  // 个人客户
  COMPANY     // 企业客户
}

// 客户
model Customer {
  id          Int          @id @default(autoincrement())
  name        String       // 客户名称
  code        String       @unique // 客户编码
  type        CustomerType @default(INDIVIDUAL) // 客户类型
  contact     String?      // 联系人
  phone       String?      // 联系电话
  email       String?      // 邮箱
  address     String?      // 地址
  creditLimit Decimal?     @db.Decimal(12, 2) // 信用额度
  period      Int          @default(0) // 账期(天)
  isEnabled   Boolean      @default(true)
  remark      String?      // 备注
  userId      Int?         @unique // 关联系统用户（如果是注册用户）
  user        User?        @relation(fields: [userId], references: [id])
  deletedAt   DateTime?    // 软删除标记
  orders      Order[]      // 销售订单
  saleReturns SaleReturn[] // 销售退货单
  reviews     Review[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([deletedAt])
}

// ==================== 商品管理模块 ====================

// SKU状态枚举
enum SkuStatus {
  ACTIVE    // 启用
  INACTIVE  // 禁用
  DELETED   // 已删除
}

// 商品SPU（标准产品单元）
model Product {
  id           Int           @id @default(autoincrement())
  name         String        // 商品名称
  spuCode      String        @unique // SPU编码
  categoryId   Int           // 分类ID
  category     Category      @relation(fields: [categoryId], references: [id])
  brandId      Int?          // 品牌ID
  brand        Brand?        @relation(fields: [brandId], references: [id])
  description  String?       // 商品描述
  detail       String?       @db.Text // 商品详情（富文本）
  mainImage    String?       // 主图
  images       String[]      // 图片列表
  unitId       Int           // 单位ID
  unit         Unit          @relation(fields: [unitId], references: [id])
  
  // 规格属性（如：颜色、尺码）
  specTemplate Json?         // 规格模板 [{name:"颜色",values:["红","蓝"]}]
  
  // 状态
  isEnabled    Boolean       @default(true)
  mallEnabled  Boolean       @default(false) // 是否在商城上架
  deletedAt    DateTime?     // 软删除标记
  
  // 关联
  skus         ProductSku[]
  mallInfo     ProductMallInfo?
  mallStat     ProductMallStat?
  reviews      Review[]
  reviewStat   ProductReviewStat?
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([deletedAt])
}

// 商品SKU（库存单元）
model ProductSku {
  id          Int         @id @default(autoincrement())
  skuCode     String      @unique // SKU编码
  productId   Int         // SPU ID
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mallInfo    ProductSkuMallInfo?
  
  // 规格组合（如：{"颜色": "红", "尺码": "XL"}）
  specs       Json        
  
  // 价格
  costPrice   Decimal     @db.Decimal(12, 2) // 成本价
  salePrice   Decimal     @db.Decimal(12, 2) // 销售价
  marketPrice Decimal?    @db.Decimal(12, 2) // 市场价
  
  // 图片
  image       String?     // SKU图片
  
  // 条码
  barcode     String?     @unique // 条形码
  weight      Decimal?    @db.Decimal(10, 3) // 重量(kg)
  volume      Decimal?    @db.Decimal(10, 3) // 体积(m³)
  
  // 库存（各仓库）
  inventories Inventory[]
  
  // 采购关联
  purchaseItems       PurchaseItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturnItems PurchaseReturnItem[]
  
  // 销售关联
  orderItems          OrderItem[]
  shipmentItems       ShipmentItem[]
  saleReturnItems     SaleReturnItem[]
  
  // 库存管理关联
  inventoryLogs       InventoryLog[]  // 库存流水
  transferItems       TransferItem[]  // 调拨明细
  adjustmentItems     AdjustmentItem[] // 调整明细
  // 购物车关联
  carts               Cart[]          // 购物车
  reviews             Review[]
  
  // 商城显示
  isDefault   Boolean     @default(false) // 是否默认SKU
  sort        Int         @default(0)
  status      SkuStatus   @default(ACTIVE)
  deletedAt   DateTime?   // 软删除标记
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([deletedAt])
}

// 商城商品扩展信息
model ProductMallInfo {
  productId    Int      @id
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String?  // 商城显示名称
  description  String?  // 商城简述
  detail       String?  @db.Text // 商城详情
  mainImage    String?  // 商城主图
  images       Json?    // 商城图片列表
  isHot        Boolean  @default(false) // 是否手动设为热门
  hotSort      Int      @default(0) // 热门排序，越小越靠前
  hotLabel     String?  // 热门标签
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 商城商品统计
model ProductMallStat {
  productId      Int      @id
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleQty7d      Int      @default(0)
  saleQty30d     Int      @default(0)
  orderCount7d   Int      @default(0)
  orderCount30d  Int      @default(0)
  hotScore       Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hotScore])
}

// 商城SKU扩展信息
model ProductSkuMallInfo {
  skuId        Int        @id
  sku          ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  salePrice    Decimal?   @db.Decimal(12, 2) // 商城销售价
  marketPrice  Decimal?   @db.Decimal(12, 2) // 商城市场价
  image        String?    // 商城SKU图片
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// 库存记录（按仓库+SKU）
model Inventory {
  id          Int        @id @default(autoincrement())
  skuId       Int
  sku         ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouseId Int
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  
  // 库存数量
  quantity    Int        @default(0) // 实际库存
  locked      Int        @default(0) // 锁定库存（已下单未发货）
  available   Int        @default(0) // 可用库存 = quantity - locked
  
  // 预警
  minStock    Int        @default(0) // 安全库存下限
  maxStock    Int        @default(999999) // 库存上限
  
  // 库位（可选）
  location    String?    // 库位编码
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@unique([skuId, warehouseId])
}

// ==================== 采购管理模块 ====================

// 采购订单状态
enum PurchaseStatus {
  PENDING    // 待审核
  APPROVED   // 已审核
  PARTIAL    // 部分入库
  COMPLETED  // 已完成
  CANCELLED  // 已取消
}

// 入库单状态
enum ReceiptStatus {
  PENDING   // 待入库
  RECEIVED  // 已入库
  CANCELLED // 已取消
}

// 采购订单
model Purchase {
  id           Int            @id @default(autoincrement())
  orderNo      String         @unique // 采购单号 CG202402010001
  supplierId   Int
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  warehouseId  Int            // 入库仓库
  
  // 金额
  totalAmount  Decimal        @db.Decimal(12, 2) // 总金额
  discount     Decimal        @default(0) @db.Decimal(12, 2) // 折扣
  payable      Decimal        @db.Decimal(12, 2) // 应付金额
  paid         Decimal        @default(0) @db.Decimal(12, 2) // 已付金额
  
  // 状态
  status       PurchaseStatus @default(PENDING)
  
  // 时间
  orderDate    DateTime       @default(now()) // 下单日期
  deliveryDate DateTime?      // 预计到货日期
  
  // 关联
  items        PurchaseItem[]
  receipts     PurchaseReceipt[]
  payments     Payment[]
  
  remark       String?
  createdBy    Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?      // 软删除标记

  @@index([deletedAt])
  @@index([status])
  @@index([supplierId])
}

// 采购订单明细
model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  skuId      Int
  sku        ProductSku @relation(fields: [skuId], references: [id])
  
  quantity   Int      // 采购数量
  received   Int      @default(0) // 已入库数量
  price      Decimal  @db.Decimal(12, 2) // 单价
  amount     Decimal  @db.Decimal(12, 2) // 金额
  
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([skuId])
}

// 采购入库单
model PurchaseReceipt {
  id          Int              @id @default(autoincrement())
  receiptNo   String           @unique // 入库单号 RK202402010001
  purchaseId  Int
  purchase    Purchase         @relation(fields: [purchaseId], references: [id])
  warehouseId Int
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  
  status      ReceiptStatus    @default(PENDING)
  
  totalAmount Decimal          @db.Decimal(12, 2)
  items       PurchaseReceiptItem[]
  returns     PurchaseReturn[]
  
  remark      String?
  createdBy   Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?        // 软删除标记

  @@index([deletedAt])
  @@index([purchaseId])
  @@index([status])
}

// 采购入库明细
model PurchaseReceiptItem {
  id        Int             @id @default(autoincrement())
  receiptId Int
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       ProductSku      @relation(fields: [skuId], references: [id])
  
  quantity  Int             // 入库数量
  price     Decimal         @db.Decimal(12, 2) // 入库单价（用于计算成本）
  
  createdAt DateTime        @default(now())

  @@index([receiptId])
  @@index([skuId])
}

// ==================== 采购退货模块 ====================

// 退货单状态
enum ReturnStatus {
  PENDING   // 待审核
  APPROVED  // 已审核
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// 采购退货单
model PurchaseReturn {
  id          Int                 @id @default(autoincrement())
  returnNo    String              @unique // 退货单号 TH202402010001
  receiptId   Int                 // 关联入库单
  receipt     PurchaseReceipt     @relation(fields: [receiptId], references: [id])
  supplierId  Int                 // 供应商
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId Int                 // 退货仓库
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])

  // 金额
  totalAmount Decimal             @db.Decimal(12, 2) // 退货总金额

  // 状态
  status      ReturnStatus        @default(PENDING)

  // 关联
  items       PurchaseReturnItem[]

  remark      String?
  createdBy   Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?           // 软删除标记

  @@index([deletedAt])
  @@index([status])
  @@index([receiptId])
  @@index([supplierId])
}

// 采购退货明细
model PurchaseReturnItem {
  id        Int            @id @default(autoincrement())
  returnId  Int
  return    PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       ProductSku     @relation(fields: [skuId], references: [id])

  quantity  Int            // 退货数量
  price     Decimal        @db.Decimal(12, 2) // 退货单价
  amount    Decimal        @db.Decimal(12, 2) // 金额

  createdAt DateTime       @default(now())

  @@index([returnId])
  @@index([skuId])
}

// ==================== 销售管理模块 ====================

// 订单类型
enum OrderType {
  SALE      // 销售订单（后台）
  MALL      // 商城订单
}

// 订单状态
enum OrderStatus {
  PENDING     // 待处理
  CONFIRMED   // 已确认
  PROCESSING  // 处理中
  SHIPPED     // 已发货
  COMPLETED   // 已完成
  CANCELLED   // 已取消
  REFUNDING   // 退款中
  REFUNDED    // 已退款
}

// 支付状态
enum PayStatus {
  UNPAID      // 未支付
  PARTIAL     // 部分支付
  PAID        // 已支付
  REFUNDING   // 退款中
  REFUNDED    // 已退款
}

// 发货状态
enum ShipStatus {
  UNSHIPPED   // 未发货
  PARTIAL     // 部分发货
  SHIPPED     // 已发货
  RECEIVED    // 已收货
}

// 发货单状态
enum ShipmentStatus {
  PENDING     // 待发货
  SHIPPED     // 已发货
  RECEIVED    // 已收货
  CANCELLED   // 已取消
}

// 销售订单
model Order {
  id           Int         @id @default(autoincrement())
  orderNo      String      @unique // 订单号 SO202402010001
  type         OrderType   @default(SALE)
  
  // 客户信息
  customerId   Int
  customer     Customer    @relation(fields: [customerId], references: [id])
  
  // 收货信息
  receiverName    String?
  receiverPhone   String?
  receiverAddress String?
  
  // 金额
  totalAmount  Decimal     @db.Decimal(12, 2)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  freight      Decimal     @default(0) @db.Decimal(12, 2)
  payable      Decimal     @db.Decimal(12, 2)
  paid         Decimal     @default(0) @db.Decimal(12, 2)
  
  // 状态
  status       OrderStatus @default(PENDING)
  payStatus    PayStatus   @default(UNPAID)
  shipStatus   ShipStatus  @default(UNSHIPPED)
  
  // 时间
  orderDate    DateTime    @default(now())
  payDate      DateTime?
  shipDate     DateTime?
  receiveDate  DateTime?
  
  // 关联
  items        OrderItem[]
  shipments    Shipment[]
  payments     Payment[]
  reviews      Review[]
  
  remark       String?
  createdBy    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([deletedAt])
  @@index([status])
  @@index([customerId])
  @@index([orderNo])
}

model OrderItem {
  id        Int        @id @default(autoincrement())
  orderId   Int
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       ProductSku @relation(fields: [skuId], references: [id])
  
  quantity  Int
  shipped   Int        @default(0)
  price     Decimal    @db.Decimal(12, 2)
  amount    Decimal    @db.Decimal(12, 2)
  
  createdAt DateTime   @default(now())
  reviews   Review[]

  @@index([orderId])
  @@index([skuId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model Review {
  id             Int          @id @default(autoincrement())
  reviewNo       String       @unique
  orderId        Int
  order          Order        @relation(fields: [orderId], references: [id])
  orderItemId    Int
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  skuId          Int
  sku            ProductSku   @relation(fields: [skuId], references: [id])
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  customerId     Int?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  rating         Int
  content        String?      @db.Text
  images         String[]
  isAnonymous    Boolean      @default(false)
  status         ReviewStatus @default(PENDING)
  replyContent   String?      @db.Text
  replyAt        DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([orderItemId, userId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([deletedAt])
}

model ProductReviewStat {
  id             Int      @id @default(autoincrement())
  productId      Int      @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalCount     Int      @default(0)
  goodCount      Int      @default(0)
  mediumCount    Int      @default(0)
  badCount       Int      @default(0)
  withImageCount Int      @default(0)
  avgRating      Decimal  @default(0) @db.Decimal(4, 2)
  updatedAt      DateTime @updatedAt
}

// 发货单
model Shipment {
  id          Int            @id @default(autoincrement())
  shipmentNo  String         @unique // 发货单号 FH202402010001
  orderId     Int
  order       Order          @relation(fields: [orderId], references: [id])
  warehouseId Int
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  
  // 物流
  logisticsCompany String?
  trackingNo       String?
  
  status      ShipmentStatus @default(PENDING)
  items       ShipmentItem[]
  saleReturns SaleReturn[]   // 销售退货单
  
  remark      String?
  createdBy   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([status])
  @@index([orderId])
}

model ShipmentItem {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  skuId      Int
  sku        ProductSku @relation(fields: [skuId], references: [id])
  quantity   Int
  
  createdAt  DateTime @default(now())

  @@index([shipmentId])
  @@index([skuId])
}

// ==================== 销售退货模块 ====================

// 销售退货单
model SaleReturn {
  id          Int                 @id @default(autoincrement())
  returnNo    String              @unique // 退货单号 XSTH202402010001
  shipmentId  Int                 // 关联发货单
  shipment    Shipment            @relation(fields: [shipmentId], references: [id])
  customerId  Int                 // 客户
  customer    Customer            @relation(fields: [customerId], references: [id])
  warehouseId Int                 // 退货仓库（入库）
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])

  // 金额
  totalAmount Decimal             @db.Decimal(12, 2) // 退货总金额

  // 状态
  status      ReturnStatus        @default(PENDING)

  // 关联
  items       SaleReturnItem[]

  remark      String?
  createdBy   Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?           // 软删除标记

  @@index([deletedAt])
  @@index([status])
  @@index([shipmentId])
  @@index([customerId])
}

// 销售退货明细
model SaleReturnItem {
  id        Int            @id @default(autoincrement())
  returnId  Int
  return    SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       ProductSku     @relation(fields: [skuId], references: [id])

  quantity  Int            // 退货数量
  price     Decimal        @db.Decimal(12, 2) // 退货单价
  amount    Decimal        @db.Decimal(12, 2) // 金额

  createdAt DateTime       @default(now())

  @@index([returnId])
  @@index([skuId])
}

// ==================== 库存管理模块（调拨、调整、流水）====================

// 库存流水类型
enum InventoryType {
  IN_PURCHASE    // 采购入库
  IN_SALE_RETURN // 销售退货入库
  IN_TRANSFER    // 调拨入库
  IN_ADJUST      // 盘点入库
  OUT_SALE       // 销售出库
  OUT_PURCHASE_RETURN // 采购退货出库
  OUT_TRANSFER   // 调拨出库
  OUT_ADJUST     // 盘点出库
}

// 库存流水（所有库存变动记录）
model InventoryLog {
  id          Int           @id @default(autoincrement())
  type        InventoryType // 变动类型
  skuId       Int
  sku         ProductSku    @relation(fields: [skuId], references: [id])
  warehouseId Int
  
  quantity    Int           // 变动数量（正数入库，负数出库）
  before      Int           // 变动前库存
  after       Int           // 变动后库存
  
  // 关联业务
  bizType     String?       // 业务类型：PURCHASE/SALE/TRANSFER/ADJUST
  bizId       Int?          // 业务单据ID
  bizNo       String?       // 业务单据号
  
  remark      String?
  createdBy   Int?
  createdAt   DateTime      @default(now())

  @@index([skuId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([bizType, bizId])
}

// 调拨单状态
enum TransferStatus {
  PENDING     // 待出库
  OUT         // 已出库
  IN          // 已入库
  COMPLETED   // 已完成
  CANCELLED   // 已取消
}

// 库存调拨单
model Transfer {
  id          Int            @id @default(autoincrement())
  transferNo  String         @unique // 调拨单号 DB202402010001
  fromId      Int            // 出库仓库
  from        Warehouse      @relation("TransferFrom", fields: [fromId], references: [id])
  toId        Int            // 入库仓库
  to          Warehouse      @relation("TransferTo", fields: [toId], references: [id])
  
  status      TransferStatus @default(PENDING)
  
  items       TransferItem[]
  
  remark      String?
  createdBy   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?      // 软删除标记

  @@index([deletedAt])
  @@index([status])
  @@index([fromId])
  @@index([toId])
}

model TransferItem {
  id         Int      @id @default(autoincrement())
  transferId Int
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  skuId      Int
  sku        ProductSku @relation(fields: [skuId], references: [id])
  quantity   Int        // 调拨数量
  
  createdAt  DateTime @default(now())

  @@index([transferId])
  @@index([skuId])
}

// 调整单状态
enum AdjustmentStatus {
  PENDING     // 待审核
  APPROVED    // 已审核
  COMPLETED   // 已完成
  CANCELLED   // 已取消
}

// 库存调整单（盘点用）
model Adjustment {
  id          Int               @id @default(autoincrement())
  adjustNo    String            @unique // 调整单号 TZ202402010001
  warehouseId Int
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  
  status      AdjustmentStatus  @default(PENDING)
  
  items       AdjustmentItem[]
  
  remark      String?
  createdBy   Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?         // 软删除标记

  @@index([deletedAt])
  @@index([status])
  @@index([warehouseId])
}

model AdjustmentItem {
  id           Int        @id @default(autoincrement())
  adjustmentId Int
  adjustment   Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  skuId        Int
  sku          ProductSku @relation(fields: [skuId], references: [id])
  
  bookQty      Int        // 账面数量
  actualQty    Int        // 实盘数量
  diffQty      Int        // 差异数量
  
  createdAt    DateTime   @default(now())

  @@index([adjustmentId])
  @@index([skuId])
}

// ==================== 商城模块（购物车）====================

// 购物车
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       ProductSku @relation(fields: [skuId], references: [id])
  quantity  Int        // 数量
  selected  Boolean    @default(true) // 是否选中
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  @@unique([userId, skuId])
  @@index([userId])
  @@index([skuId])
}

// ==================== 财务管理模块 ====================

// 收付款类型
enum PaymentType {
  RECEIPT  // 收款
  PAYMENT  // 付款
}

// 支付方式
enum PaymentMethod {
  CASH      // 现金
  BANK      // 银行转账
  ALIPAY    // 支付宝
  WECHAT    // 微信支付
  CREDIT    // 挂账/赊销
}

// 收付款状态
enum PaymentStatus {
  PENDING   // 待确认
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// 收付款记录
model Payment {
  id          Int           @id @default(autoincrement())
  type        PaymentType   // 收款/付款
  bizType     String        // 业务类型：PURCHASE/SALE
  
  // 关联单据
  orderId     Int?          // 销售订单ID
  order       Order?        @relation(fields: [orderId], references: [id])
  purchaseId  Int?          // 采购订单ID
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id])
  
  amount      Decimal       @db.Decimal(12, 2) // 金额
  method      PaymentMethod // 支付方式
  status      PaymentStatus @default(PENDING)
  
  remark      String?
  createdBy   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?     // 软删除标记

  @@index([deletedAt])
  @@index([type])
  @@index([status])
  @@index([purchaseId])
  @@index([orderId])
}
