generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 用户模型
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  email     String?   @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 软删除标记

  // 用户与角色多对多关系
  roles     Role[]    @relation("UserRoles")
  // 关联客户档案（一个用户对应一个客户）
  customer  Customer?

  @@index([deletedAt])
}

// 角色模型
model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // 软删除标记

  // 角色与用户多对多关系
  users       User[]    @relation("UserRoles")
  // 角色与菜单多对多关系
  menus       Menu[]    @relation("RoleMenus")

  @@index([deletedAt])
}

// 菜单模型（树形结构）
model Menu {
  id          Int       @id @default(autoincrement())
  name        String
  path        String?
  icon        String?
  component   String?
  redirect    String?
  parentId    Int?
  order       Int       @default(0)
  hidden      Boolean   @default(false)
  alwaysShow  Boolean   @default(false)
  type        String    @default("menu") // menu, button, iframe
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // 软删除标记

  // 自关联 - 父级菜单
  parent      Menu?     @relation("MenuChildren", fields: [parentId], references: [id])
  children    Menu[]    @relation("MenuChildren")

  // 角色与菜单多对多关系
  roles       Role[]    @relation("RoleMenus")

  @@index([deletedAt])
}

// ==================== 基础数据模块 ====================

// 计量单位
model Unit {
  id        Int       @id @default(autoincrement())
  name      String    @unique // 单位名称：个、箱、kg
  code      String    @unique // 单位编码
  sort      Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 软删除标记

  @@index([deletedAt])
}

// 商品分类（树形结构）
model Category {
  id        Int        @id @default(autoincrement())
  name      String     // 分类名称
  code      String     @unique // 分类编码
  parentId  Int?       // 父级ID
  level     Int        @default(1) // 层级
  sort      Int        @default(0)
  icon      String?    // 图标
  image     String?    // 分类图片
  isEnabled Boolean    @default(true)
  deletedAt DateTime?  // 软删除标记
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([deletedAt])
}

// 品牌
model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique // 品牌名称
  logo        String?   // 品牌logo
  description String?   // 品牌描述
  sort        Int       @default(0)
  isEnabled   Boolean   @default(true)
  deletedAt   DateTime? // 软删除标记
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

// 仓库
model Warehouse {
  id          Int               @id @default(autoincrement())
  name        String            // 仓库名称
  code        String            @unique // 仓库编码
  address     String?           // 地址
  contact     String?           // 联系人
  phone       String?           // 联系电话
  isDefault   Boolean           @default(false) // 是否默认仓库
  isEnabled   Boolean           @default(true)
  deletedAt   DateTime?         // 软删除标记
  inventories Inventory[]
  receipts    PurchaseReceipt[]
  returns     PurchaseReturn[] // 采购退货单
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([deletedAt])
}

// 供应商
model Supplier {
  id          Int       @id @default(autoincrement())
  name        String    // 供应商名称
  code        String    @unique // 供应商编码
  contact     String?   // 联系人
  phone       String?   // 联系电话
  email       String?   // 邮箱
  address     String?   // 地址
  bankName    String?   // 开户行
  bankAccount String?   // 银行账号
  taxNo       String?   // 税号
  creditLimit Decimal?  @db.Decimal(12, 2) // 信用额度
  period      Int       @default(30) // 账期(天)
  isEnabled   Boolean   @default(true)
  remark      String?   // 备注
  deletedAt   DateTime? // 软删除标记
  purchases   Purchase[] // 采购订单
  returns     PurchaseReturn[] // 采购退货单
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

// 客户类型枚举
enum CustomerType {
  INDIVIDUAL  // 个人客户
  COMPANY     // 企业客户
}

// 客户
model Customer {
  id          Int          @id @default(autoincrement())
  name        String       // 客户名称
  code        String       @unique // 客户编码
  type        CustomerType @default(INDIVIDUAL) // 客户类型
  contact     String?      // 联系人
  phone       String?      // 联系电话
  email       String?      // 邮箱
  address     String?      // 地址
  creditLimit Decimal?     @db.Decimal(12, 2) // 信用额度
  period      Int          @default(0) // 账期(天)
  isEnabled   Boolean      @default(true)
  remark      String?      // 备注
  userId      Int?         @unique // 关联系统用户（如果是注册用户）
  user        User?        @relation(fields: [userId], references: [id])
  deletedAt   DateTime?    // 软删除标记
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([deletedAt])
}

// ==================== 商品管理模块 ====================

// SKU状态枚举
enum SkuStatus {
  ACTIVE    // 启用
  INACTIVE  // 禁用
  DELETED   // 已删除
}

// 商品SPU（标准产品单元）
model Product {
  id           Int           @id @default(autoincrement())
  name         String        // 商品名称
  spuCode      String        @unique // SPU编码
  categoryId   Int           // 分类ID
  category     Category      @relation(fields: [categoryId], references: [id])
  brandId      Int?          // 品牌ID
  brand        Brand?        @relation(fields: [brandId], references: [id])
  description  String?       // 商品描述
  detail       String?       @db.Text // 商品详情（富文本）
  mainImage    String?       // 主图
  images       String[]      // 图片列表
  unitId       Int           // 单位ID
  unit         Unit          @relation(fields: [unitId], references: [id])
  
  // 规格属性（如：颜色、尺码）
  specTemplate Json?         // 规格模板 [{name:"颜色",values:["红","蓝"]}]
  
  // 状态
  isEnabled    Boolean       @default(true)
  deletedAt    DateTime?     // 软删除标记
  
  // 关联
  skus         ProductSku[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([deletedAt])
}

// 商品SKU（库存单元）
model ProductSku {
  id          Int         @id @default(autoincrement())
  skuCode     String      @unique // SKU编码
  productId   Int         // SPU ID
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // 规格组合（如：{"颜色": "红", "尺码": "XL"}）
  specs       Json        
  
  // 价格
  costPrice   Decimal     @db.Decimal(12, 2) // 成本价
  salePrice   Decimal     @db.Decimal(12, 2) // 销售价
  marketPrice Decimal?    @db.Decimal(12, 2) // 市场价
  
  // 图片
  image       String?     // SKU图片
  
  // 条码
  barcode     String?     @unique // 条形码
  weight      Decimal?    @db.Decimal(10, 3) // 重量(kg)
  volume      Decimal?    @db.Decimal(10, 3) // 体积(m³)
  
  // 库存（各仓库）
  inventories Inventory[]
  
  // 采购关联
  purchaseItems       PurchaseItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  purchaseReturnItems PurchaseReturnItem[]
  
  // 商城显示
  isDefault   Boolean     @default(false) // 是否默认SKU
  sort        Int         @default(0)
  status      SkuStatus   @default(ACTIVE)
  deletedAt   DateTime?   // 软删除标记
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([deletedAt])
}

// 库存记录（按仓库+SKU）
model Inventory {
  id          Int        @id @default(autoincrement())
  skuId       Int
  sku         ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouseId Int
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id])
  
  // 库存数量
  quantity    Int        @default(0) // 实际库存
  locked      Int        @default(0) // 锁定库存（已下单未发货）
  available   Int        @default(0) // 可用库存 = quantity - locked
  
  // 预警
  minStock    Int        @default(0) // 安全库存下限
  maxStock    Int        @default(999999) // 库存上限
  
  // 库位（可选）
  location    String?    // 库位编码
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@unique([skuId, warehouseId])
}

// ==================== 采购管理模块 ====================

// 采购订单状态
enum PurchaseStatus {
  PENDING    // 待审核
  APPROVED   // 已审核
  PARTIAL    // 部分入库
  COMPLETED  // 已完成
  CANCELLED  // 已取消
}

// 入库单状态
enum ReceiptStatus {
  PENDING   // 待入库
  RECEIVED  // 已入库
  CANCELLED // 已取消
}

// 采购订单
model Purchase {
  id           Int            @id @default(autoincrement())
  orderNo      String         @unique // 采购单号 CG202402010001
  supplierId   Int
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  warehouseId  Int            // 入库仓库
  
  // 金额
  totalAmount  Decimal        @db.Decimal(12, 2) // 总金额
  discount     Decimal        @default(0) @db.Decimal(12, 2) // 折扣
  payable      Decimal        @db.Decimal(12, 2) // 应付金额
  paid         Decimal        @default(0) @db.Decimal(12, 2) // 已付金额
  
  // 状态
  status       PurchaseStatus @default(PENDING)
  
  // 时间
  orderDate    DateTime       @default(now()) // 下单日期
  deliveryDate DateTime?      // 预计到货日期
  
  // 关联
  items        PurchaseItem[]
  receipts     PurchaseReceipt[]
  payments     Payment[]
  
  remark       String?
  createdBy    Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?      // 软删除标记

  @@index([deletedAt])
  @@index([status])
  @@index([supplierId])
}

// 采购订单明细
model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  skuId      Int
  sku        ProductSku @relation(fields: [skuId], references: [id])
  
  quantity   Int      // 采购数量
  received   Int      @default(0) // 已入库数量
  price      Decimal  @db.Decimal(12, 2) // 单价
  amount     Decimal  @db.Decimal(12, 2) // 金额
  
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([skuId])
}

// 采购入库单
model PurchaseReceipt {
  id          Int              @id @default(autoincrement())
  receiptNo   String           @unique // 入库单号 RK202402010001
  purchaseId  Int
  purchase    Purchase         @relation(fields: [purchaseId], references: [id])
  warehouseId Int
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  
  status      ReceiptStatus    @default(PENDING)
  
  totalAmount Decimal          @db.Decimal(12, 2)
  items       PurchaseReceiptItem[]
  returns     PurchaseReturn[]
  
  remark      String?
  createdBy   Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?        // 软删除标记

  @@index([deletedAt])
  @@index([purchaseId])
  @@index([status])
}

// 采购入库明细
model PurchaseReceiptItem {
  id        Int             @id @default(autoincrement())
  receiptId Int
  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       ProductSku      @relation(fields: [skuId], references: [id])
  
  quantity  Int             // 入库数量
  price     Decimal         @db.Decimal(12, 2) // 入库单价（用于计算成本）
  
  createdAt DateTime        @default(now())

  @@index([receiptId])
  @@index([skuId])
}

// ==================== 采购退货模块 ====================

// 退货单状态
enum ReturnStatus {
  PENDING   // 待审核
  APPROVED  // 已审核
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// 采购退货单
model PurchaseReturn {
  id          Int                 @id @default(autoincrement())
  returnNo    String              @unique // 退货单号 TH202402010001
  receiptId   Int                 // 关联入库单
  receipt     PurchaseReceipt     @relation(fields: [receiptId], references: [id])
  supplierId  Int                 // 供应商
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId Int                 // 退货仓库
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])

  // 金额
  totalAmount Decimal             @db.Decimal(12, 2) // 退货总金额

  // 状态
  status      ReturnStatus        @default(PENDING)

  // 关联
  items       PurchaseReturnItem[]

  remark      String?
  createdBy   Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?           // 软删除标记

  @@index([deletedAt])
  @@index([status])
  @@index([receiptId])
  @@index([supplierId])
}

// 采购退货明细
model PurchaseReturnItem {
  id        Int            @id @default(autoincrement())
  returnId  Int
  return    PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       ProductSku     @relation(fields: [skuId], references: [id])

  quantity  Int            // 退货数量
  price     Decimal        @db.Decimal(12, 2) // 退货单价
  amount    Decimal        @db.Decimal(12, 2) // 金额

  createdAt DateTime       @default(now())

  @@index([returnId])
  @@index([skuId])
}

// ==================== 财务管理模块 ====================

// 收付款类型
enum PaymentType {
  RECEIPT  // 收款
  PAYMENT  // 付款
}

// 支付方式
enum PaymentMethod {
  CASH      // 现金
  BANK      // 银行转账
  ALIPAY    // 支付宝
  WECHAT    // 微信支付
  CREDIT    // 挂账/赊销
}

// 收付款状态
enum PaymentStatus {
  PENDING   // 待确认
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// 收付款记录
model Payment {
  id          Int           @id @default(autoincrement())
  type        PaymentType   // 收款/付款
  bizType     String        // 业务类型：PURCHASE/SALE
  
  // 关联单据
  orderId     Int?          // 销售订单ID
  purchaseId  Int?          // 采购订单ID
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id])
  
  amount      Decimal       @db.Decimal(12, 2) // 金额
  method      PaymentMethod // 支付方式
  status      PaymentStatus @default(PENDING)
  
  remark      String?
  createdBy   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?     // 软删除标记

  @@index([deletedAt])
  @@index([type])
  @@index([status])
  @@index([purchaseId])
}
